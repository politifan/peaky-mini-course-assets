      "id": "01-version",
      "title": "Клиент и сервер Docker",
      "rows": [
        {
          "command": "docker version --format \"Client {{.Client.Version}} / Server {{.Server.Version}}\"",
          "output": "Client 26.1.5+dfsg1 / Server 26.1.5+dfsg1\n",
          "exit_code": 0
        },
        {
          "command": "docker image ls nginx:1.28-alpine",
